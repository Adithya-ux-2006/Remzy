{
  "name": "remzy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "npx playwright test",
    "test": "npx playwright test",
    "db:migrate": "node scripts/db-migrate.js",
    "db:migrate:dry": "node scripts/db-migrate.js --dry-run",
    "db:migrate:status": "node scripts/db-migrate.js --status",
    "db:validate": "node scripts/db-validate.js",
    "db:diff": "node scripts/db-diff.js",
    "db:diff:output": "node scripts/db-diff.js --output supabase/pending_migration.sql",
    "db:generate-schema": "node scripts/generate-schema.js",
    "db:generate-schema:dry": "node scripts/generate-schema.js --dry-run"
    ,"content:verify-citations": "node scripts/verify-citations.js"
    ,"content:verify-primary": "node scripts/verify-citations.js --scope=primary"
    ,"content:audit-integration": "node scripts/remedy-integration-audit.mjs"
    ,"content:gate": "npm run content:verify-citations && npm run content:verify-sources -- --no-http && npm run content:audit-integration"
    ,"content:verify-sources": "node scripts/evidence-source-pipeline.mjs"
    ,"content:sync-evidence": "node scripts/evidence-source-pipeline.mjs --write"
    ,"auth:verify-google": "node scripts/verify-google-auth.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.12.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "docx": "^9.7.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "shadcn": "^4.13.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  }
}
